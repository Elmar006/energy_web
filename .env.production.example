# Copy to .env.production, generate five DIFFERENT random hexadecimal secrets.
# Never use example placeholders unchanged. Database passwords must be URL-safe.
POSTGRES_PASSWORD=replace-owner-password-with-64-random-hex-chars
RUNTIME_DB_PASSWORD=replace-runtime-password-with-64-random-hex-chars
API_TOKEN=replace-api-token-with-64-random-hex-chars
SESSION_SECRET=replace-session-key-with-64-random-hex-chars
APP_ACCESS_PASSWORD=replace-access-password-with-64-random-hex-chars
APP_PUBLIC_ORIGIN=https://planner.your-domain.ru
FRONTEND_PORT=53002
DGIS_MAPGL_API_KEY=
DGIS_MAP_STYLE_ID=
